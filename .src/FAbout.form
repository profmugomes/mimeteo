# Gambas Form File 3.0

{ Form Form
  MoveScaled(0,0,73,57)
  Font = Font["12"]
  Text = ("About MiMeteo")
  Icon = Picture["mimeteo.png"]
  Resizable = False
  { Label2 Label
    MoveScaled(1,1,66,4)
    #Translate = False
    Font = Font["Bold"]
    Alignment = Align.TopLeft
    Text = "MiMeteo"
  }
  { TextArea1 TextArea
    MoveScaled(1,28,71,28)
    #Translate = False
    Font = Font["11"]
    Text = "MiMeteo is free software: you can redistribute it and/or modify it under the terms of the GNU General Public License as published by the Free Software Foundation, only version 2 of the License.\n\nMiMeteo is distributed in the hope that it will be useful, but WITHOUT ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the GNU General Public License for more details."
    ReadOnly = True
    Wrap = True
    ScrollBar = Scroll.Vertical
  }
  { Label1 Label
    MoveScaled(1,19.375,66,4)
    #Translate = False
    Alignment = Align.TopLeft
    Text = "Copyright (C) 2026 Murilo Gomes <profmugomes.com.br>"
  }
  { lblDesenvolvidoPor Label
    MoveScaled(1,12,66,4)
    #Translate = False
    Alignment = Align.TopLeft
    Text = "Developed by: Murilo Gomes"
  }
  { Label4 Label
    MoveScaled(1,15,37,4)
    #Translate = False
    Text = "Site:"
  }
  { URLLabel1 URLLabel
    MoveScaled(6,15,42,4)
    #Translate = False
    Text = "profmugomes.com.br"
  }
  { Label6 Label
    MoveScaled(1,21.875,30,5)
    #Translate = False
    Text = "License: GPL-2.0-only"
  }
  { Label7 Label
    MoveScaled(1,4.5,70,3)
    #Translate = False
    Text = "É um software para ver a previsão do tempo no Brasil."
  }
  { PictureBox1 PictureBox
    MoveScaled(57,3,11,11)
    #Translate = False
    Picture = Picture.Load("mimeteo.png")
    Stretch = True
  }
  { lblVersion Label
    MoveScaled(1,8.625,66,4)
    #Translate = False
    Alignment = Align.TopLeft
    Text = "Version: {version}"
  }
}
