Public Function getBuscarClima(lat As String, lon As String) As Variant
  
  Dim sBuffer As String
  Dim c As New HttpClient
  
  c.URL = Subst("https://api.open-meteo.com/v1/forecast?latitude=&1&longitude=&2&current_weather=true&hourly=temperature_2m,precipitation,snowfall&daily=temperature_2m_max,temperature_2m_min,precipitation_sum,snowfall_sum&timezone=auto", lat, lon)
  c.Async = False
  c.Timeout = 60
  Try c.Get()
  
  If Lof(c) Then sBuffer = Read #c, Lof(c)
  
  If sBuffer = "" Then 
    Message.Error("Não foi possível se comunicar com a API do IBGE!")
  Endif
  
  c.Close()
  
  Return JSON.Decode(sBuffer)
  
End

Public Function ClimaAtual(data As Variant) As String[]
  
  Dim current As Variant = data["current_weather"]
  
  If TypeOf(current) <> gb.Object Then 
    Message.Error("Indisponível")
  Endif
  
  Dim clima As New String[]
  Dim sData As String = Replace(current["time"], "T", " ")
  sData = Mid(sData, 9, 2) & "/" & Mid(sData, 6, 2) & "/" & Left(sData, 4)

  System.Language = "C"
  
  clima.Add(sData)
  clima.Add(Format(current["temperature"], "0.00") & " °C")
  clima.Add(Format(current["windspeed"], "0.00") & " mm")
  
  Return clima
  
End

Public Function PrevisaoDiaria(data As Variant, days As Integer) As String[]
  
  Dim daily As Variant = data["daily"]
  Dim i As Integer
  
  If TypeOf(daily) <> gb.Object Then 
    Message.Error("Previsão diária indisponível!")
  Endif
  
  Dim dates As Variant[] = daily["time"]
  Dim max As Variant[] = daily["temperature_2m_max"]
  Dim min As Variant[] = daily["temperature_2m_min"]
  Dim rain As Variant[] = daily["precipitation_sum"]
  Dim snow As Variant[] = daily["snowfall_sum"]
  
  Dim sResult As New String[]
  
  For i = 0 To days - 1
    If i >= dates.Count Then Break 
    
    System.Language = "C"
  
    sResult.Add(Subst("&1|&2|&3|&4|&5", Mid(dates[i], 9, 2) & "/" & Mid(dates[i], 6, 2) & "/" & Left(dates[i], 4), Format(max[i], "0.00") & " °C", Format(min[i], "0.00") & " °C", Format(rain[i], "0.00") & " mm", Format(snow[i], "0.00") & " mm"))
  Next
  
  Return sResult
  
End

