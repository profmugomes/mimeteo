' Gambas module file

Public Function getListaEstados() As Variant
  
  Dim sBuffer As String
  Dim c As New HttpClient
  
  c.URL = "https://servicodados.ibge.gov.br/api/v1/localidades/estados"
  c.Async = False
  c.Timeout = 60
  Try c.Get()
  
  If Lof(c) Then sBuffer = Read #c, Lof(c)
  
  If sBuffer = "" Then 
    Message.Error("Não foi possível se comunicar com a API do IBGE!")
  Endif  
  
  c.Close()

  Return JSON.Decode(sBuffer)
  
End

Public Function getListaCidades(estado As String) As Variant
  
  Dim sBuffer As String
  Dim c As New HttpClient
  
  c.URL = Subst("https://servicodados.ibge.gov.br/api/v1/localidades/estados/&1/municipios", estado)
  c.Async = False
  c.Timeout = 60
  Try c.Get()
  
  If Lof(c) Then sBuffer = Read #c, Lof(c)
  
  If sBuffer = "" Then 
    Message.Error("Não foi possível se comunicar com a API do IBGE!")
  Endif
  
  c.Close()
  
  Return JSON.Decode(sBuffer)
  
End

Public Function getLocalizacao(municipioID As Integer) As String[]
  
  Dim sBuffer As String
  Dim c As New HttpClient
  Dim data As Variant
  
  Dim coords As New String[]
  
  c.URL = Subst("https://servicodados.ibge.gov.br/api/v4/malhas/municipios/&1/metadados", municipioID)
  c.Async = False
  c.Timeout = 60
  Try c.Get()
  
  If Lof(c) Then sBuffer = Read #c, Lof(c)
  
  If sBuffer = "" Then 
    Message.Error("Não foi possível se comunicar com a API do IBGE!")
  Endif
  
  c.Close()
  
  data = JSON.Decode(sBuffer)
  
  coords.Add(data[0]["centroide"]["latitude"])
  coords.Add(data[0]["centroide"]["longitude"])
  
  Return coords
End