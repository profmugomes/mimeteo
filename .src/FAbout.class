Public Sub URLLabel1_Click()
  
  Dim sTerm As String
  
  Shell "xdg-open \"https://www.profmugomes.com.br\"" To sTerm
  
End

Public Sub Form_Open()

  lblVersion.Text = Replace(lblVersion.Text, "{version}", Application.Version)

End
