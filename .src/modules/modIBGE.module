Private hTask As TaskGet
Private sBuffer As String

Public Function getListaEstados() As Variant
  
  If Exist(FMain.pathCache & "/estados.json") Then
    sBuffer = File.Load(FMain.pathCache & "/estados.json")
  Else
    hTask = New TaskGet("https://servicodados.ibge.gov.br/api/v1/localidades/estados")
    Object.Attach(hTask, Me, "hTask")
    hTask.Wait()

    File.Save(FMain.pathCache & "/estados.json", sBuffer)
  Endif

  Return JSON.Decode(sBuffer)
  
End

Public Function getListaCidades(estado As String) As Variant
  
  If Exist(FMain.pathCache & Subst("/cidades_&1.json", estado)) Then
    sBuffer = File.Load(FMain.pathCache & Subst("/cidades_&1.json", estado))
  Else 
    hTask = New TaskGet(Subst("https://servicodados.ibge.gov.br/api/v1/localidades/estados/&1/municipios", estado))
    Object.Attach(hTask, Me, "hTask")
    hTask.Wait()
    
    File.Save(FMain.pathCache & Subst("/cidades_&1.json", estado), sBuffer)
  Endif
  
  Return JSON.Decode(sBuffer)
  
End

Public Function getLocalizacao(municipioID As Integer) As String[]

  Dim data As Variant
  Dim coords As New String[]
  
  If Exist(FMain.pathCache & Subst("/metadados_&1.json", municipioID)) Then
    sBuffer = File.Load(FMain.pathCache & Subst("/metadados_&1.json", municipioID))
  Else
    hTask = New TaskGet(Subst("https://servicodados.ibge.gov.br/api/v4/malhas/municipios/&1/metadados", municipioID))
    Object.Attach(hTask, Me, "hTask")
    hTask.Wait()
      
    File.Save(FMain.pathCache & Subst("/metadados_&1.json", municipioID), sBuffer)
  Endif
  
  data = JSON.Decode(sBuffer)

  coords.Add(data[0]["centroide"]["latitude"])
  coords.Add(data[0]["centroide"]["longitude"])
  
  Return coords
End

Public Sub hTask_Kill()
  sBuffer = hTask.Value

  If sBuffer = "" Then
    Message.Error("Não foi possível obter os estados!")
    Return
  Endif

End
